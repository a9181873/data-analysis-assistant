# ============================================
# API 金鑰設定範本
# 複製此檔為 .env 後填入你的金鑰（.env 已被 gitignore，不會上傳）
# ============================================

# --- Google Gemini（免費層可用）---
# 到 https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# --- OpenRouter（一個 key 用多種模型，含免費 DeepSeek V3）---
# 到 https://openrouter.ai/keys 建立
OPENROUTER_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
